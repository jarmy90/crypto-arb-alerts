# GitHub Configuration
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required permissions: repo (full control of private repositories)
GITHUB_TOKEN=ghp_your_token_here

# Your public repository in format: username/repository-name
# Example: johndoe/crypto-arb-alerts
GITHUB_REPO=your_username/your_repo

# Path to alerts file in the repository
GITHUB_FILE_PATH=data/alerts.json

# Detection Parameters
# Minimum net spread percentage to trigger alert (after fees)
MIN_NET_SPREAD=0.40

# Trade sizes evaluated (quote currency of each market)
FEE_TAKER_BINANCE=0.10
FEE_TAKER_MEXC=0.05
FEE_TAKER_BYBIT=0.10
FEE_TAKER_OKX=0.10
# Legacy aliases (used when FEE_TAKER_* missing)
FEE_BINANCE=0.10
FEE_MEXC=0.05

# Exchange fees MAKer (in percentage, limit orders in queue)
FEE_MAKER_BINANCE=0.10
FEE_MAKER_MEXC=0.05
FEE_MAKER_BYBIT=0.10
FEE_MAKER_OKX=0.10

# Fee verification (0 = NO VERIFICADA, uses conservative listed value + badge)
FEE_VERIFIED_BINANCE=0
FEE_VERIFIED_MEXC=0
FEE_VERIFIED_BYBIT=0
FEE_VERIFIED_OKX=0

# Dynamic threshold risks (in percentage points)
LATENCY_RISK=0.05
PARTIAL_FILL_RISK=0.05
EXITVOL_K=1.0
SAFETY_MARGIN=0.05

# Trade sizes evaluated (quote currency of each market)
TRADE_SIZES=25,50,100,250,500,1000
TRADE_SIZE_USDT=500

# Depth / queue monitor
THIN_BOOK_USDT=1000
DEPTH_INTERVAL=30
EXIT_MIN_USDT=500
PERSIST_READS=2
MAX_DATA_AGE_S=90

# Presignal timing (ms; scan cadence dominates in practice, see README note)
PRE_SIGNAL_MIN_MS=2000
PREPARE_MIN_MS=4000
MAX_SIGNAL_GAP_MS=1000
MAX_SIGNAL_GAP_S=300
NEAR_BAND=0.10
DATA_MAX_AGE_MS=2000
SYNC_MAX_AGE_MS=1500

# How often to check for opportunities (in seconds)
CHECK_INTERVAL=8

# Cooldown between alerts for the same symbol (in seconds)
COOLDOWN_SECONDS=90

# Maximum number of alerts to keep in the JSON file
MAX_ALERTS=50

# Trading pairs to monitor (comma-separated)
SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,XRP/USDT,ADA/USDT,DOGE/USDT,DOT/USDT,MATIC/USDT,LTC/USDT,AVAX/USDT,LINK/USDT,UNI/USDT,ATOM/USDT,NEAR/USDT
