# ==============================================================================
# CONFIGURACIÓN MAESTRA DE COPY TRADING (INVO -> MEXC)
# ==============================================================================

# Credenciales de API MEXC (NUNCA SUBIR A GIT)
MEXC_API_KEY=mx0vglqeTlcbzgtfjr
MEXC_SECRET_KEY=00b60f4257e342b997dc5be3e1584d7a

# ------------------------------------------------------------------------------
# 1. GESTIÓN DE CAPITAL (BANKROLL & ASIGNACIÓN)
# ------------------------------------------------------------------------------
# Saldo total de la cuenta
BANK_TOTAL_USDT=353.04

# Porcentaje de margen asignado por operación (5.0% = ~$15 a $17 USDT por trade)
MARGIN_PER_TRADE_PERCENT=5.0

# Reserva de seguridad intocable (20% del total = ~70.61 USDT)
SAFETY_RESERVE_PERCENT=20.0

# Máximo número de posiciones abiertas simultáneamente
MAX_CONCURRENT_POSITIONS=5

# ------------------------------------------------------------------------------
# 2. GESTIÓN DE SALIDAS (TAKE PROFIT & STOP LOSS)
# ------------------------------------------------------------------------------
# Si el trader en Invo tiene TP y SL definidos, se respetan sus niveles
USE_TRADER_TP_SL=true

# Si el trader NO pone TP o SL (Modo Protección Asimétrica 2:1 sobre margen ROE):
# Take Profit por defecto (+10.0% de ganancia sobre el margen)
DEFAULT_TP_ROE_PERCENT=10.0

# Stop Loss por defecto (-5.0% de pérdida máxima sobre el margen)
DEFAULT_SL_ROE_PERCENT=5.0

# Si el trader cierra manualmente la posición en Invo antes de tocar TP/SL, el bot cierra de inmediato
AUTO_CLOSE_ON_TRADER_EXIT=true

# ------------------------------------------------------------------------------
# 3. LECTURA DE SEÑALES (INVO NOTIFICATIONS)
# ------------------------------------------------------------------------------
INVO_NOTIFICATIONS_URL=https://app.invoapp.com/notifications
INVO_POLL_INTERVAL_SECONDS=45
INVO_DOUBLE_CHECK_DELAY_SECONDS=10
